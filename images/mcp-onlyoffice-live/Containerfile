FROM docker.io/library/node:24.21.0-bookworm-slim@sha256:d6aa754f16b3197301076f047b5def2f02ea1dbbc2ca920407d46d7ec7f87b20

LABEL org.opencontainers.image.title="mcp-onlyoffice-live" \
      org.opencontainers.image.description="MCP server that co-edits ONLYOFFICE documents in Nextcloud live, as the calling agent" \
      org.opencontainers.image.source="https://github.com/hoolia/apps.openshift.eu" \
      org.opencontainers.image.licenses="Apache-2.0"

ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    NODE_ENV=production \
    HOME=/tmp

WORKDIR /app
COPY package.json package-lock.json ./
# headless Chromium shell and its libraries only; readable by the arbitrary user OpenShift assigns
RUN npm ci --omit=dev --ignore-scripts \
 && npx --no-install playwright-core install --with-deps --only-shell chromium \
 && chmod -R a+rX /ms-playwright /app \
 && rm -rf /root/.npm /root/.cache /var/lib/apt/lists/* /tmp/*
COPY src ./src
COPY plugin ./plugin

USER 1001
EXPOSE 13081
CMD ["node", "src/server.js"]
