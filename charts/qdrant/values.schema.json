{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "size": {"type": "string", "pattern": "^[0-9]+(Mi|Gi|Ti)$"},
        "storageClass": {"type": "string"}
      }
    },
    "resources": {"type": "object"},
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {"enum": ["kubernetes", "externalSecret"]},
        "apiKey": {"type": "string"},
        "externalSecret": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "storeKind": {"enum": ["ClusterSecretStore", "SecretStore"]},
            "storeName": {"type": "string"},
            "refreshInterval": {"type": "string"},
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "apiKey": {"type": "string"}
              }
            }
          }
        }
      }
    },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "configMap": {"type": "boolean"}
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "ingressNamespaces": {"type": "array", "items": {"type": "object"}}
      }
    },
    "mcp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {"type": "string"},
            "tag": {"type": "string"},
            "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
          }
        },
        "collection": {"type": "string", "minLength": 1},
        "port": {"type": "integer", "minimum": 1024, "maximum": 65535, "not": {"enum": [6333, 6334, 8080, 8443]}},
        "path": {"type": "string", "pattern": "^/"},
        "appProtocol": {"type": "string"},
        "targetName": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]{0,30}[a-z0-9])?$"},
        "findDescription": {"type": "string", "minLength": 1},
        "storeDescription": {"type": "string", "minLength": 1},
        "extraEnv": {"type": "object", "additionalProperties": {"type": "string"}},
        "podLabels": {"type": "object", "additionalProperties": {"type": "string"}},
        "resources": {"type": "object"},
        "ingressNamespaces": {"type": "array", "items": {"type": "object"}},
        "allowInternet": {"type": "boolean"}
      }
    }
  }
}
