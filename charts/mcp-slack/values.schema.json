{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object"
    },
    "team": {
      "type": "string"
    },
    "tenant": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean"
    },
    "nameOverride": {
      "type": "string",
      "maxLength": 63
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "slack": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "tokenKey": {
          "type": "string",
          "minLength": 1
        },
        "tokenType": {
          "type": "string",
          "enum": [
            "bot",
            "user"
          ]
        },
        "secretSuffix": {
          "type": "string",
          "minLength": 1
        },
        "addMessage": {
          "type": "boolean"
        },
        "addMessageChannels": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^!?[CGD][A-Z0-9]+$"
          }
        },
        "reactions": {
          "type": "boolean"
        },
        "enabledTools": {
          "type": "string"
        },
        "cacheTtl": {
          "type": "string",
          "minLength": 1
        },
        "logLevel": {
          "type": "string",
          "enum": [
            "debug",
            "info",
            "warn",
            "error"
          ]
        }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "kubernetes",
            "externalSecret"
          ]
        },
        "botToken": {
          "type": "string"
        },
        "externalSecret": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "storeKind": {
              "type": "string",
              "enum": [
                "SecretStore",
                "ClusterSecretStore"
              ]
            },
            "storeName": {
              "type": "string"
            },
            "refreshInterval": {
              "type": "string"
            },
            "item": {
              "type": "string"
            },
            "property": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "port": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 65535,
      "not": {
        "enum": [
          8080,
          8443
        ]
      }
    },
    "mcp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "appProtocol": {
          "type": "string"
        },
        "labelDomain": {
          "type": "string",
          "minLength": 1
        },
        "server": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "bundle": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "category": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "labels": {
          "type": "object"
        },
        "annotations": {
          "type": "object"
        }
      }
    },
    "resources": {
      "type": "object"
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "issuerUrl": {
          "type": "string",
          "pattern": "^(https?://[^\\s]+)?$"
        },
        "audiences": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "allowedGroups": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "resourceUrl": {
          "type": "string"
        },
        "groupsClaim": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:/-]+$"
        },
        "upstreamPort": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535
        },
        "skipAuthRoutes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "upstreamTimeout": {
          "type": "string",
          "pattern": "^[0-9]+(ms|s|m|h)$"
        },
        "flushInterval": {
          "type": "string",
          "pattern": "^[0-9]+(ms|s|m|h)$"
        },
        "existingSecret": {
          "type": "string"
        },
        "cookieSecret": {
          "type": "string"
        },
        "clientSecret": {
          "type": "string"
        },
        "extraArgs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^--"
          }
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "minLength": 1
            },
            "pullPolicy": {
              "type": "string",
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          }
        },
        "resources": {
          "type": "object"
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ingressNamespaces": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "egress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "exceptCidrs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "extraExceptCidrs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "dnsNamespace": {
              "type": "string"
            },
            "dnsPort": {
              "type": "integer"
            }
          }
        }
      }
    },
    "mcp-auth": {
      "type": "object"
    }
  }
}
