{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[0-9a-f]{64})?$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "build": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "revision": {
          "type": [
            "string",
            "integer"
          ],
          "pattern": "^[A-Za-z0-9_.-]*$"
        },
        "wait": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 60
            }
          }
        },
        "output": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "ImageStreamTag",
                "DockerImage"
              ]
            },
            "name": {
              "type": "string"
            },
            "pushSecret": {
              "type": "string"
            }
          }
        },
        "toolsImage": {
          "type": "string"
        },
        "pullSecret": {
          "type": "string"
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "kind",
              "command",
              "check"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "uv",
                  "npm",
                  "pip",
                  "venv",
                  "tarball"
                ]
              },
              "command": {
                "type": "string",
                "minLength": 1
              },
              "args": {
                "type": "string"
              },
              "check": {
                "type": "string",
                "minLength": 1
              },
              "keep": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "route": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string"
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "timeout": {
          "type": "string",
          "pattern": "^[0-9]+(s|m|h)$"
        }
      }
    },
    "oauth": {
      "type": "object",
      "properties": {
        "ownerEmail": {
          "type": "string"
        },
        "loginClusterRole": {
          "type": "string"
        },
        "allowedGroups": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "secrets": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "kubernetes",
            "externalSecret"
          ]
        }
      }
    },
    "git": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string",
          "pattern": "^$|^[a-z0-9.-]+(:[0-9]+)?$"
        },
        "uiSecretName": {
          "type": "string"
        },
        "providers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "type"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "github",
                  "gitlab"
                ]
              },
              "host": {
                "type": "string",
                "pattern": "^$|^[a-z0-9.-]+(:[0-9]+)?$"
              },
              "secretName": {
                "type": "string",
                "pattern": "^$|^[A-Za-z0-9_]+$"
              }
            }
          }
        },
        "repositoriesDir": {
          "type": "string",
          "pattern": "^$|^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$"
        },
        "repositories": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^https://[^@\\s]+$"
          }
        }
      }
    },
    "gateway": {
      "type": "object",
      "properties": {
        "upstream": {
          "type": "string",
          "pattern": "^$|^https?://"
        }
      }
    },
    "mcpServers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "path"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "path": {
            "type": "string",
            "pattern": "^/"
          },
          "timeout": {
            "type": "integer",
            "minimum": 1
          },
          "enabled": {
            "type": "boolean"
          }
        }
      }
    },
    "env": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "storage": {
      "type": "object",
      "properties": {
        "accessMode": {
          "type": "string",
          "enum": [
            "ReadWriteOnce",
            "ReadWriteMany"
          ]
        }
      }
    },
    "kubernetesMcpServer": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "deniedResources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "group",
              "version",
              "kind"
            ],
            "properties": {
              "group": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "agentSecrets": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "agentProfiles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "acp_server"
        ],
        "properties": {
          "acp_server": {
            "type": "string"
          },
          "acp_model": {
            "type": "string"
          }
        }
      }
    },
    "mcp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "interval": {
          "type": "integer",
          "minimum": 10
        },
        "labelSelector": {
          "type": "string"
        },
        "labelDomain": {
          "type": "string"
        },
        "bundles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "servers": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "url": {
                    "type": "string",
                    "pattern": "^https?://"
                  },
                  "auth": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "secretRef",
                      "tokenKey"
                    ],
                    "properties": {
                      "secretRef": {
                        "type": "string",
                        "minLength": 1
                      },
                      "header": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9-]+$"
                      },
                      "format": {
                        "enum": [
                          "basic",
                          "bearer",
                          "raw"
                        ]
                      },
                      "userKey": {
                        "type": "string"
                      },
                      "tokenKey": {
                        "type": "string",
                        "minLength": 1
                      },
                      "namespace": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            ]
          }
        },
        "resources": {
          "type": "object"
        },
        "clusterRole": {
          "type": "string"
        }
      }
    },
    "mcpDiscovery": {
      "description": "Deprecated former name of mcp; its keys override mcp",
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "interval": {
          "type": "integer",
          "minimum": 10
        },
        "labelSelector": {
          "type": "string"
        },
        "labelDomain": {
          "type": "string"
        },
        "bundles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "servers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "resources": {
          "type": "object"
        },
        "clusterRole": {
          "type": "string"
        }
      }
    },
    "mcpOAuth": {
      "type": "object",
      "properties": {
        "callbackPort": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        }
      }
    },
    "mcpPublish": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "resync": {
          "type": "integer",
          "minimum": 60
        }
      }
    },
    "a2a": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "port": {
          "type": "integer"
        },
        "description": {
          "type": "string"
        },
        "staticTokenSecret": {
          "type": "string"
        },
        "tenantAuth": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "tenant": {
              "type": "string"
            },
            "kubernetesIssuer": {
              "type": "string"
            },
            "oidcIssuers": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "resources": {
          "type": "object"
        },
        "kagent": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "resources": {
              "type": "object"
            }
          }
        }
      }
    },
    "team": {
      "type": "string",
      "pattern": "^([a-z0-9]([a-z0-9-]*[a-z0-9])?)?$"
    },
    "tenant": {
      "type": "string",
      "pattern": "^([a-z0-9]([a-z0-9-]*[a-z0-9])?)?$"
    },
    "condenser": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "maxSize": {
          "type": "integer",
          "minimum": 20
        },
        "keepFirst": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "vaultSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "data"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
          },
          "item": {
            "type": "string"
          },
          "storeKind": {
            "enum": [
              "",
              "ClusterSecretStore",
              "SecretStore"
            ]
          },
          "storeName": {
            "type": "string"
          },
          "refreshInterval": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {
              "pattern": "^[-._a-zA-Z0-9]+$"
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "agent": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
