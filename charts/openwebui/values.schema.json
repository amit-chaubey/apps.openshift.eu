{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "person": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "pattern": "^$|^[a-z0-9]([-a-z0-9]{0,40}[a-z0-9])?$"},
        "email": {"type": "string", "pattern": "^$|^[^@\\s]+@[^@\\s]+$"}
      }
    },
    "route": {
      "type": "object",
      "properties": {
        "host": {"type": "string"},
        "labels": {"type": "object", "additionalProperties": {"type": "string"}},
        "timeout": {"type": "string", "pattern": "^[0-9]+(ms|s|m|h)$"},
        "annotations": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "oauth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ownerEmail": {"type": "string", "pattern": "^$|^[^@\\s]+@[^@\\s]+$"},
        "allowedGroups": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "loginClusterRole": {"type": "string"}
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {"enum": ["kubernetes", "externalSecret"]},
        "cookieSecret": {"type": "string"},
        "secretKey": {"type": "string"},
        "externalSecret": {
          "type": "object",
          "properties": {
            "storeKind": {"enum": ["ClusterSecretStore", "SecretStore"]},
            "storeName": {"type": "string"},
            "refreshInterval": {"type": "string"},
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "cookieSecret": {"type": "string"},
                "secretKey": {"type": "string"}
              }
            }
          }
        }
      }
    },
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "upstream": {"type": "string", "pattern": "^$|^https?://"},
        "audience": {"type": "string"}
      }
    },
    "openwebui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": {"type": "string", "minLength": 1},
        "title": {"type": "string"},
        "persistentConfig": {"type": "boolean"},
        "env": {"type": "object", "additionalProperties": {"type": ["string", "number", "boolean"]}},
        "resources": {"type": "object"}
      }
    },
    "oauthProxy": {
      "type": "object",
      "properties": {
        "image": {"type": "string", "minLength": 1},
        "port": {"type": "integer"},
        "resources": {"type": "object"}
      }
    },
    "tokenProxy": {
      "type": "object",
      "properties": {
        "image": {"type": "string", "minLength": 1},
        "port": {"type": "integer"},
        "resources": {"type": "object"}
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "size": {"type": "string", "minLength": 1},
        "accessMode": {"enum": ["ReadWriteOnce", "ReadWriteMany"]},
        "className": {"type": "string"}
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"}
      }
    }
  }
}
