{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object"
    },
    "team": {
      "type": "string"
    },
    "tenant": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean"
    },
    "nameOverride": {
      "type": "string",
      "maxLength": 63
    },
    "url": {
      "type": "string",
      "pattern": "^https://"
    },
    "scopes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "write": {
      "type": "boolean"
    },
    "writeScopes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "mcp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "labelDomain": {
          "type": "string",
          "minLength": 1
        },
        "server": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "bundle": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "category": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "addon": {
          "type": "boolean"
        },
        "description": {
          "type": "string"
        },
        "icon": {
          "type": "string"
        }
      }
    },
    "oauthClient": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "secretSuffix": {
          "type": "string",
          "minLength": 1
        },
        "create": {
          "type": "boolean"
        }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "kubernetes",
            "externalSecret"
          ]
        },
        "clientId": {
          "type": "string"
        },
        "clientSecret": {
          "type": "string"
        },
        "externalSecret": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "storeKind": {
              "type": "string",
              "enum": [
                "SecretStore",
                "ClusterSecretStore"
              ]
            },
            "storeName": {
              "type": "string"
            },
            "refreshInterval": {
              "type": "string"
            },
            "item": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
